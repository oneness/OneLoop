#!/usr/bin/env bash
set -euo pipefail

# Download the three GGUF artifacts behind Ollama's
# muse-glimmer:30b-q4_K_M-dflash tag. Downloads are resumable and only become
# final files after their size and SHA-256 digest have been verified.

MODEL_DIR="${MODEL_DIR:-$HOME/models}"
REGISTRY="https://registry.ollama.ai/v2/library/muse-glimmer/blobs"

command -v curl >/dev/null || { echo "error: curl not found" >&2; exit 1; }
command -v sha256sum >/dev/null || { echo "error: sha256sum not found" >&2; exit 1; }

mkdir -p "$MODEL_DIR"

download() {
  local name="$1"
  local bytes="$2"
  local digest="$3"
  local target="$MODEL_DIR/$name"
  local partial="$target.part"
  local actual_bytes
  local actual_digest

  if [ -f "$target" ]; then
    actual_bytes=$(stat -c %s "$target")
    actual_digest=$(sha256sum "$target" | cut -d' ' -f1)
    if [ "$actual_bytes" = "$bytes" ] && [ "$actual_digest" = "$digest" ]; then
      echo "verified existing $target"
      return
    fi
    echo "error: existing file does not match the pinned artifact: $target" >&2
    exit 1
  fi

  echo "downloading $name"
  curl --fail --location --retry 12 --retry-all-errors --retry-delay 5 \
    --continue-at - --progress-bar \
    --output "$partial" "$REGISTRY/sha256:$digest"

  actual_bytes=$(stat -c %s "$partial")
  if [ "$actual_bytes" != "$bytes" ]; then
    echo "error: $partial is $actual_bytes bytes; expected $bytes" >&2
    echo "re-run this script to resume the download" >&2
    exit 1
  fi

  actual_digest=$(sha256sum "$partial" | cut -d' ' -f1)
  if [ "$actual_digest" != "$digest" ]; then
    echo "error: checksum mismatch for $partial" >&2
    exit 1
  fi

  mv "$partial" "$target"
  echo "saved $target"
}

# Pinned from the Ollama registry manifest for
# muse-glimmer:30b-q4_K_M-dflash.
download "mmproj-kquant.gguf" \
  1400328928 \
  f48b452316f9b213758e8659444029b961a24a07f99a1abb2a9f88b06f7c00c6

download "muse-glimmer-30B-kquant-17gb.gguf" \
  16756681056 \
  71b5c9c9abbc2a9e7c13550b6f9fe1f062650117a24490b15a310cbd7de03f8b

download "dflash-kquant.gguf" \
  1631205312 \
  27d9a805fa29b943cfb6ad4843367cd4eaaaf06bd452d8cc3e00a2cd18a677bc

echo
echo "Muse Glimmer and its DFlash draft are ready in $MODEL_DIR"
