#!/usr/bin/env bash
set -euo pipefail

# List the models OpenRouter currently surfaces as Trending and Most Popular,
# with the per-token input and output price and the context window.
#
# The two rankings come from different places, because the OpenRouter UI shows
# them in different places too:
#
#   Trending     is a usage ranking from the rankings page, reporting token
#                volume over a day, week or month window.
#   Most Popular pairs the ordering of the model catalogue, which the models
#                page shows by default, with the usage figures OpenRouter
#                embeds alongside the catalogue. Token volume is what matches
#                that ordering: request count and spend do not. Ranking by
#                spend would surface expensive models, which is not what the
#                UI shows.
#
# Both tables are strictly sorted by the token count they display, descending,
# before the limit is applied. Neither source returns that order itself: the
# rankings endpoint follows its own metric rather than total prompt tokens,
# and the catalogue order is only approximately token ordered. So both
# builders sort explicitly instead of trusting the response order.
#
# Both endpoints are public and need no API key.
#
# The OpenCode Go plan is a third source, reporting on a different population:
# the models OpenCode's own users can run on its subscription rather than
# OpenRouter's traffic. Its table lives at https://opencode.ai/go and lists,
# per model, the estimated requests per 5 hours and the monthly usage limit,
# for the Go plan and for the Go Plus plan. The free models report no limit at
# all. That page has no documented API, but it is server rendered, so the
# table is read straight out of the HTML.
#
# Only the free models and the three paid models with the most requests per 5
# hours are shown: the free ones because they cost nothing, the paid ones
# because the request count is what says how much traffic a model carries.
#
# The rankings return dated permaslugs such as
# `openai/gpt-6-luna-20260922`, while the price catalogue keys on the bare
# model id, so this strips the date suffix before joining.
#
# Usage: ./model-trends [--help] [--limit N] [--view day|week|month]
#
# Requires: curl, jq

usage() {
  cat <<'EOF'
usage: ./model-trends [--limit N] [--view day|week|month]

Show the trending and the most popular models on OpenRouter, each with its
input price, output price and context window, then the OpenCode Go plan.
Prices and costs are US dollars.

  --limit N              how many models to show per list (default 15)
  --view day|week|month  window for the trending list (default week)

The OpenCode table lists every free model of the Go plan and the three paid
models with the most requests per 5 hours, each with a bar drawn from that
request count.
EOF
}

limit=15
view=week

# How many paid models the OpenCode table shows. The free ones are always
# listed in full, so this only trims the paid end.
paid_limit=3

# How wide the usage bar is, in cells.
bar_width=20

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --limit)
      shift
      [ $# -gt 0 ] || { echo "error: --limit needs a value" >&2; exit 2; }
      limit=$1
      shift
      ;;
    --limit=*)
      limit=${1#--limit=}
      shift
      ;;
    --view)
      shift
      [ $# -gt 0 ] || { echo "error: --view needs a value" >&2; exit 2; }
      view=$1
      shift
      ;;
    --view=*)
      view=${1#--view=}
      shift
      ;;
    *)
      echo "unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$limit" in
  ''|*[!0-9]*)
    echo "error: --limit must be a positive number" >&2
    exit 2
    ;;
esac
[ "$limit" -gt 0 ] || { echo "error: --limit must be greater than zero" >&2; exit 2; }

case "$view" in
  day|week|month) ;;
  *)
    echo "error: --view must be day, week or month" >&2
    exit 2
    ;;
esac

for tool in curl jq; do
  command -v "$tool" >/dev/null || {
    echo "error: $tool not found" >&2
    exit 1
  }
done

api_get() {
  curl --fail --silent --show-error --location \
    --header "Accept: application/json" \
    --header "User-Agent: OneLoop-model-trends" \
    "$@"
}

# Trending ranks the usage figures from the rankings page by token volume.
# The parameter is `metric`, not `sort`; an unknown value is ignored and
# silently returns a default ordering.
fetch_trending() {
  api_get --get \
    --data-urlencode "view=$view" \
    --data-urlencode "metric=tokens_excl_byok" \
    "https://openrouter.ai/api/frontend/v1/rankings/models"
}

# Most Popular is the catalogue's own ordering. The parameter is `order`; this
# endpoint accepts a `sort` parameter and ignores it, which silently returns the
# default ordering instead.
fetch_most_popular() {
  api_get --get \
    --data-urlencode "order=most-popular" \
    "https://openrouter.ai/api/frontend/v1/models/find"
}

fetch_catalogue() {
  api_get "https://openrouter.ai/api/v1/models"
}

# The OpenCode Go plan page is plain HTML rather than JSON, so it gets its own
# fetch with an HTML Accept header.
fetch_opencode_go() {
  curl --fail --silent --show-error --location \
    --header "Accept: text/html" \
    --header "User-Agent: OneLoop-model-trends" \
    "https://opencode.ai/go"
}

# Trending: join the usage ranking against the price catalogue and emit one
# record per model. The documents arrive as files because the catalogue is too
# large to pass as a command line argument.
#
# Both OpenRouter tables are strictly sorted by the token count they display,
# descending, before the limit is applied. The rankings endpoint does not
# return a strict total_prompt_tokens ordering (it follows its own metric),
# so this sorts explicitly rather than trusting the response order.
#
# A ranked model missing from the catalogue keeps its position in the sorted
# order and reports "n/a" rather than disappearing.
build_trending_rows() {
  local ranking=$1
  local catalogue=$2
  local popular=$3

  jq -nr --argjson limit "$limit" \
    --slurpfile ranking "$ranking" \
    --slurpfile catalogue "$catalogue" \
    --slurpfile popular "$popular" '
      # Rankings identify a model by permaslug and a variant separately.
      # Match the variant to its catalogue id so free and batch usage does not
      # get labeled as standard usage.
      def variant_suffix($variant):
        if $variant == "batch" then ":batch"
        elif $variant == "free" then ":free"
        else "" end;
      def bare_id: sub("-[0-9]{8}$"; "");
      def model_id: sub(":(batch|free)$"; "") | bare_id;

      ($catalogue[0].data | map(select(.canonical_slug != null))
          | group_by(.canonical_slug)
          | map({key: .[0].canonical_slug, value: .})
          | from_entries) as $by_canonical
      | ($catalogue[0].data | map({key: .id, value: .}) | from_entries) as $catalogue_by_id
      | # Frontend endpoints cover ranked models missing from the public
        # catalogue. Index them by their actual endpoint variant.
        ($popular[0].data.models
          | map(select(.endpoint.pricing != null)
              | (.endpoint.variant // "standard") as $variant
              | {key: (.slug + variant_suffix($variant)), value: .endpoint})
          | from_entries) as $endpoints
      | ([
          $ranking[0].data[]
          | . as $ranked
          | select($ranked.model_permaslug != null and $ranked.model_permaslug != "" and $ranked.variant != "batch")
          | ($by_canonical[$ranked.model_permaslug] // []) as $entries
          | ($ranked.variant // "standard") as $variant
          | (if $variant == "batch" then ($entries | map(select(.id | endswith(":batch"))) | .[0])
             elif $variant == "free" then ($entries | map(select(.id | endswith(":free"))) | .[0])
             else (($entries | map(select(((.id | endswith(":batch")) | not) and ((.id | endswith(":free")) | not))) | .[0]) // $entries[0])
             end) as $entry
          | (($ranked.variant_permaslug // $ranked.model_permaslug) | model_id) as $base_id
          | (if $entry != null then $entry.id
             else $base_id + variant_suffix($variant) end) as $id
          | ($catalogue_by_id[$id] // null) as $catalogue_entry
          | ($endpoints[$id] // $endpoints[$base_id + variant_suffix($variant)] // $endpoints[$base_id] // null) as $endpoint
          | {
              id: $id,
              context: ($entry.context_length // $catalogue_entry.context_length // $endpoint.context_length // 0),
              prompt: ($endpoint.pricing.prompt // $entry.pricing.prompt // $catalogue_entry.pricing.prompt // null),
              completion: ($endpoint.pricing.completion // $entry.pricing.completion // $catalogue_entry.pricing.completion // null),
              tokens: ($ranked.total_prompt_tokens // 0)
            }
        ]
        | sort_by(-.tokens)
        | .[0:$limit][]
        | [
            .id,
            (.context | tostring),
            (.prompt | tostring),
            (.completion | tostring),
            (.tokens | tostring)
          ]
          | @tsv)
    '
}

# Most Popular: that response already carries the ranking and the model
# records together. Its per-model records use `slug` rather than `id` and hold
# no pricing, so the public catalogue supplies the prices. The usage figures it
# embeds are keyed by permaslug and variant, so each model-variant row reports
# its own token volume rather than combining other variants.
#
# The catalogue order is only approximately token ordered, so this sorts all
# candidates by the token count actually displayed, descending, before the
# limit is applied.
build_most_popular_rows() {
  local popular=$1
  local catalogue=$2

  jq -nr --argjson limit "$limit" \
    --slurpfile popular "$popular" \
    --slurpfile catalogue "$catalogue" '
      def variant_suffix($variant):
        if $variant == "batch" then ":batch"
        elif $variant == "free" then ":free"
        else "" end;

      ($catalogue[0].data | map(select(.canonical_slug != null))
          | group_by(.canonical_slug)
          | map({key: .[0].canonical_slug, value: .})
          | from_entries) as $by_canonical
      | # Exclude batch variants from the displayed models. Keep analytics
        # separated by variant so the displayed count and ordering match.
        ($popular[0].data.analytics
          | to_entries
          | map(.value)
          | group_by(.model_permaslug)
          | map({
              key: .[0].model_permaslug,
              value: (group_by(.variant)
                | map({key: .[0].variant, value: (map(.total_prompt_tokens // 0) | add // 0)})
                | from_entries)
            })
          | from_entries) as $tokens

      | ([
          $popular[0].data.models[]
          | . as $ranked
          | select($ranked.permaslug != null and $ranked.permaslug != "")
          | ($ranked.endpoint.variant // "standard") as $variant
          | select($variant != "batch")
          | ($by_canonical[$ranked.permaslug] // []) as $entries
          | (if $variant == "batch" then ($entries | map(select(.id | endswith(":batch"))) | .[0])
             elif $variant == "free" then ($entries | map(select(.id | endswith(":free"))) | .[0])
             else (($entries | map(select(((.id | endswith(":batch")) | not) and ((.id | endswith(":free")) | not))) | .[0]) // $entries[0])
             end) as $entry
          | (if $entry != null then $entry.id
             else ($ranked.slug // "") + variant_suffix($variant) end) as $id
          | {
              id: $id,
              context: ($entry.context_length // $ranked.endpoint.context_length // $ranked.context_length // 0),
              prompt: ($ranked.endpoint.pricing.prompt // $entry.pricing.prompt // null),
              completion: ($ranked.endpoint.pricing.completion // $entry.pricing.completion // null),
              tokens: ($tokens[$ranked.permaslug][$variant] // 0)
            }
        ]
        | sort_by(-.tokens)
        | .[0:$limit][]
        | [
            .id,
            (.context | tostring),
            (.prompt | tostring),
            (.completion | tostring),
            (.tokens | tostring)
          ]
          | @tsv)
    '
}

# The OpenCode Go plan table is read out of the server rendered page. Each row
# holds the model name and two number cells: the requests per 5 hours and the
# monthly usage limit, each for the Go plan and then for the Go Plus plan. A
# value the page strikes through is a superseded one, and only the current
# value counts.
#
# The Go plan is the one reported, because it is the plan anyone can buy, and
# the free models report no limit at all.
#
# The rows come out as TSV: name, requests per 5 hours, monthly usage, free
# flag, and the request count as a number for ranking.
parse_go_rows() {
  local page=$1

  awk '
    # The text of one number cell. A struck through value is dropped, the
    # hydration markers carry no text, and the remaining tags separate the
    # values from each other.
    function cell_values(cell,   text, count, parts, out, i) {
      text = cell
      gsub(/<s[^>]*>[^<]*<\/s>/, "", text)
      gsub(/<!--[^>]*-->/, "", text)
      gsub(/<[^>]*>/, " ", text)

      count = split(text, parts, /[ \t]+/)
      out = ""
      for (i = 1; i <= count; i++) {
        if (parts[i] == "") continue
        out = out (out == "" ? "" : "\t") parts[i]
      }
      return out
    }

    # A row starts at <tr, which is rare enough in the page to be a safe
    # record separator.
    BEGIN { RS = "<tr" }

    {
      # The header row and the axis row carry no numbers, and the page holds
      # only this one table.
      if (index($0, "data-slot=\"number\"") == 0) next

      if (match($0, /<bdi>[^<]*<\/bdi>/) == 0) next
      name = substr($0, RSTART + 5, RLENGTH - 11)
      if (name == "") next

      split($0, cells, /<td data-slot="number">/)
      if (length(cells) < 3) next

      split(cell_values(cells[2]), requests, "\t")
      split(cell_values(cells[3]), monthly, "\t")
      if (length(requests) < 2 || length(monthly) < 2) next

      # A model is free when its name says so, or when it reports no limit at
      # all: the page writes an infinity rather than a number for those, and
      # the two markers always agree.
      free = (tolower(name) ~ /free/ || requests[1] !~ /^[0-9,]+$/) ? 1 : 0

      # The page groups thousands with a comma, and a free model reports an
      # infinity, which reads as zero here because the free models are picked
      # out before anything is ranked.
      count = requests[1]
      gsub(/,/, "", count)

      print name "\t" requests[1] "\t" monthly[1] "\t" free "\t" (count + 0)
    }
  ' "$page"
}

# The free models are listed in full and the paid models in descending order of
# requests per 5 hours, trimmed to the top few. The bar is drawn against the
# largest request count on the page, so the paid models read as a share of the
# busiest one, and a free model takes the whole bar because it has no limit.
build_go_rows() {
  local rows=$1

  jq -nr --argjson paid_limit "$paid_limit" --argjson bar_width "$bar_width" --arg rows "$rows" '
    def record: split("\t") | {
      name: .[0],
      requests: .[1],
      monthly: .[2],
      free: (.[3] == "1"),
      count: (.[4] | tonumber)
    };

    ($rows | split("\n") | map(select(length > 0)) | map(record)) as $all
    | ($all | map(select(.free))) as $free
    | ($all | map(select(.free | not)) | sort_by(-.count)) as $paid
    | ($paid[0:$paid_limit]) as $top
    | ($all | map(.count) | max // 0) as $max
    | ($free + $top)[]
    | . as $row
    | (if $row.free then $bar_width
       elif $max == 0 then 0
       else ((($row.count / $max) * $bar_width) | round) end) as $filled
    | [
        $row.name,
        $row.requests,
        $row.monthly,
        ("█" * $filled)
      ]
    | @tsv
  '
}

# Prices are quoted per token, which is awkward to read. Convert to US dollars
# per million tokens, keeping enough decimals that a tenth-of-a-cent rate does
# not round down to a misleading zero.
format_price() {
  local value=$1

  case "$value" in
    ''|null)
      printf 'n/a'
      return
      ;;
  esac

  # OpenRouter reports a negative price for its own routing models, whose cost
  # depends on the provider chosen at request time. That is not a price.
  if [ "$(printf '%s' "$value" | awk '{print ($1 < 0)}')" = 1 ]; then
    printf 'varies'
    return
  fi

  if [ "$(printf '%s' "$value" | awk '{print ($1 == 0)}')" = 1 ]; then
    printf 'free'
    return
  fi

  jq -nr --arg value "$value" '
    ($value | tonumber) * 1000000 as $per_million
    | if $per_million >= 1
      then ($per_million * 100 | round / 100)
      else ($per_million * 10000 | round / 10000)
      end
    | tostring
    | if . == "0" then "<0.0001" else . end
  '
}

# Context windows are reported in thousands of tokens. Three decimals is exact:
# an integer token count divided by 1000 always lands on a thousandth, so
# 1048576 shows as 1048.576 and multiplying by 1000 recovers it.
format_context() {
  local value=$1

  case "$value" in
    ''|null|0)
      printf 'n/a'
      return
      ;;
  esac

  jq -nr --argjson value "$value" '
    ($value / 1000 * 1000 | round / 1000) | tostring
  '
}

# Display counts in billions to match the table header. Two decimals are kept
# even when the second is a zero, so every row in the column has the same
# width and the decimal points line up down the table.
format_tokens() {
  local value=$1

  case "$value" in
    ''|null|0)
      printf 'n/a'
      return
      ;;
  esac

  jq -nr --argjson value "$value" '
    (($value / 10000000) | round) as $cents
    | (($cents / 100) | floor) as $whole
    | ($cents - ($whole * 100)) as $fraction
    | "\($whole).\(if $fraction < 10 then "0" else "" end)\($fraction)"
  '
}

# The two OpenRouter tables share a column shape, so one formatter serves both.
# The builders emit raw values; this turns them into the strings to display.
format_openrouter_rows() {
  local model_id context prompt completion tokens

  while IFS=$'\t' read -r model_id context prompt completion tokens; do
    [ -n "$model_id" ] || continue
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$model_id" \
      "$(format_price "$prompt")" \
      "$(format_price "$completion")" \
      "$(format_context "$context")" \
      "$(format_tokens "$tokens")"
  done <<<"$1"
}

# Render a TSV table. The first column is left aligned, the rest right aligned,
# and every column is as wide as its widest cell, so one printer serves all
# three tables.
#
# The widths are counted in characters rather than bytes, so a cell holding an
# infinity sign or a bar still lines up whatever the locale says.
print_table() {
  local title=$1
  local header=$2
  local rows=$3

  echo "========================================"
  echo "$title"
  echo "========================================"

  if [ -z "$rows" ]; then
    echo "no models returned"
    echo
    return
  fi

  jq -nr --arg header "$header" --arg rows "$rows" '
    def cells: split("\t");

    ($header | cells) as $head
    | ($rows | split("\n") | map(select(length > 0)) | map(cells)) as $body
    | ($head | length) as $count
    | ([$head] + $body) as $all
    | [ range(0; $count) as $i
        | ([$all[] | .[$i] // "" | length] | max)
      ] as $widths
    | def row:
        . as $cells
        | [ range(0; $count) as $i
            | ($cells[$i] // "") as $cell
            | (($widths[$i] - ($cell | length)) | if . < 0 then 0 else . end) as $gap
            | if $i == 0
              then $cell + (" " * $gap)
              else "  " + (" " * $gap) + $cell
              end
          ]
        | join("");
      (($head | row), ("-" * (([$widths[]] | add) + 2 * ($count - 1))), ($body[] | row))
    '

  echo
}

catalogue=$(mktemp)
ranking=$(mktemp)
popular=$(mktemp)
opencode_page=$(mktemp)
trap 'rm -f "$catalogue" "$ranking" "$popular" "$opencode_page"' EXIT

fetch_catalogue >"$catalogue"

fetch_trending >"$ranking"
fetch_most_popular >"$popular"

# The Go plan page is HTML and the least stable of the sources, so a page that
# cannot be read leaves the other tables standing rather than taking the whole
# run down with it.
go_rows=""
if fetch_opencode_go >"$opencode_page"; then
  go_rows=$(parse_go_rows "$opencode_page")
fi

openrouter_header=$(printf 'MODEL ID\tIN ($/M)\tOUT ($/M)\tCTX (k)\tTOKENS (B)')

print_table "Most Popular" \
  "$openrouter_header" \
  "$(format_openrouter_rows "$(build_most_popular_rows "$popular" "$catalogue")")"

print_table "Trending by tokens ($view)" \
  "$openrouter_header" \
  "$(format_openrouter_rows "$(build_trending_rows "$ranking" "$catalogue" "$popular")")"

print_table "OpenCode Go plan (free models, top $paid_limit paid)" \
  "$(printf 'MODEL\tREQ/5H\tMONTHLY\tUSAGE')" \
  "$(build_go_rows "$go_rows")"

if [ -z "$go_rows" ]; then
  echo "note: the Go plan table could not be read from https://opencode.ai/go"
  echo
fi

echo "note: the Go Plus plan raises these limits; see https://opencode.ai/go"
echo
echo "Sources: https://openrouter.ai/rankings, https://openrouter.ai/models and https://opencode.ai/go"
