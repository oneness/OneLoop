#!/usr/bin/env bash
set -euo pipefail

# List the models OpenRouter currently surfaces as Trending and Most Popular,
# with the per-token input and output price and the context window.
#
# The two rankings come from different places, because the OpenRouter UI shows
# them in different places too:
#
#   Trending     is a usage ranking from the rankings page, ordered by token
#                volume over a day, week or month window.
#   Most Popular is the ordering of the model catalogue, which the models page
#                shows by default. It is also token based: measured against the
#                usage figures OpenRouter embeds alongside the catalogue, the
#                token ordering reproduces the catalogue ordering closely,
#                while request count and spend do not. Ranking by spend would
#                surface expensive models, which is not what the UI shows.
#
# Both endpoints are public and need no API key.
#
# The OpenCode leaderboard is a third source, reporting on a different
# population: the models used by OpenCode's own users rather than OpenRouter's
# traffic. It lives at https://opencode.ai/data/, which hydrates from plain
# JSON documents and is undocumented -- the documented OpenCode API covers its
# local server, not these statistics. Its index carries the ranking and the
# token volume for the chosen window but nothing else, so each row costs one
# more request for the model document. That document supplies the cost, summed
# over the last entries of its daily series for the same window, and also the
# context window and the canonical model id. OpenCode has no month window, so a
# month view reads its week.
#
# The rankings return dated permaslugs such as
# `openai/gpt-6-luna-20260922`, while the price catalogue keys on the bare
# model id, so this strips the date suffix before joining.
#
# Usage: ./model-trends [--help] [--limit N] [--view day|week|month]
#
# Requires: curl, jq

usage() {
  cat <<'EOF'
usage: ./model-trends [--limit N] [--view day|week|month]

Show the trending and the most popular models on OpenRouter, each with its
input price, output price and context window, then the OpenCode usage
leaderboard. Prices and costs are US dollars.

  --limit N              how many models to show per list (default 15)
  --view day|week|month  window for the trending list and the OpenCode
                         leaderboard (default week)

The OpenCode table needs one extra request per model, so --limit N adds roughly
N + 1 requests on top of the three the OpenRouter tables need. OpenCode has no
month window, so a month view shows its week and says so.
EOF
}

limit=15
view=week

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --limit)
      shift
      [ $# -gt 0 ] || { echo "error: --limit needs a value" >&2; exit 2; }
      limit=$1
      shift
      ;;
    --limit=*)
      limit=${1#--limit=}
      shift
      ;;
    --view)
      shift
      [ $# -gt 0 ] || { echo "error: --view needs a value" >&2; exit 2; }
      view=$1
      shift
      ;;
    --view=*)
      view=${1#--view=}
      shift
      ;;
    *)
      echo "unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$limit" in
  ''|*[!0-9]*)
    echo "error: --limit must be a positive number" >&2
    exit 2
    ;;
esac
[ "$limit" -gt 0 ] || { echo "error: --limit must be greater than zero" >&2; exit 2; }

case "$view" in
  day|week|month) ;;
  *)
    echo "error: --view must be day, week or month" >&2
    exit 2
    ;;
esac

for tool in curl jq; do
  command -v "$tool" >/dev/null || {
    echo "error: $tool not found" >&2
    exit 1
  }
done

api_get() {
  curl --fail --silent --show-error --location \
    --header "Accept: application/json" \
    --header "User-Agent: OneLoop-model-trends" \
    "$@"
}

# Trending ranks the usage figures from the rankings page by token volume.
# The parameter is `metric`, not `sort`; an unknown value is ignored and
# silently returns a default ordering.
fetch_trending() {
  api_get --get \
    --data-urlencode "view=$view" \
    --data-urlencode "metric=tokens_excl_byok" \
    "https://openrouter.ai/api/frontend/v1/rankings/models"
}

# Most Popular is the catalogue's own ordering. The parameter is `order`; this
# endpoint accepts a `sort` parameter and ignores it, which silently returns the
# default ordering instead.
fetch_most_popular() {
  api_get --get \
    --data-urlencode "order=most-popular" \
    "https://openrouter.ai/api/frontend/v1/models/find"
}

fetch_catalogue() {
  api_get "https://openrouter.ai/api/v1/models"
}

# OpenCode publishes one document for the whole dataset and one per model. The
# index is keyed by lab and model, and a model may redirect to its canonical
# slug, which api_get follows.
fetch_opencode_index() {
  api_get "https://opencode.ai/data/index.json"
}

fetch_opencode_model() {
  api_get "https://opencode.ai/data/$1/$2.json"
}

# Trending: join the usage ranking against the price catalogue and emit one
# record per model. The documents arrive as files because the catalogue is too
# large to pass as a command line argument.
#
# A ranked model missing from the catalogue keeps its position and reports
# "n/a" rather than disappearing, so the ranking stays faithful.
build_trending_rows() {
  local ranking=$1
  local catalogue=$2
  local popular=$3

  jq -nr --argjson limit "$limit" \
    --slurpfile ranking "$ranking" \
    --slurpfile catalogue "$catalogue" \
    --slurpfile popular "$popular" '
      # Rankings identify catalogue models by canonical_slug, while the
      # displayed OpenRouter id may include a variant such as :free or :batch.
      def bare_id: sub("-[0-9]{8}$"; "");

      ($catalogue[0].data | map(select(.canonical_slug != null)
          | { key: .canonical_slug, value: . }) | from_entries) as $by_canonical
      | ($catalogue[0].data | map({ key: .id, value: . }) | from_entries) as $catalogue
      | # The rankings include models available through frontend endpoints but
        # missing from /api/v1/models. Their endpoint pricing is still usable.
        ($popular[0].data.models
          | map(select(.endpoint.pricing != null)
              | {key: .slug, value: .endpoint})
          | from_entries) as $endpoints
      | $ranking[0].data[0:$limit]
      | .[]
      | . as $ranked
      | (($by_canonical[$ranked.model_permaslug] // null) as $entry
          | ($entry.id // ($ranked.model_permaslug | bare_id)) as $id
          | ($endpoints[$id] // $endpoints[($ranked.model_permaslug | bare_id)] // null) as $endpoint
          | [
              $id,
              (($entry.context_length // $endpoint.context_length // 0) | tostring),
              (($entry.pricing.prompt // $endpoint.pricing.prompt // null) | tostring),
              (($entry.pricing.completion // $endpoint.pricing.completion // null) | tostring),
              (($ranked.total_prompt_tokens // 0) | tostring)
            ]
          | @tsv)
    '
}

# Most Popular: that response already carries the ranking and the model
# records together. Its per-model records use `slug` rather than `id` and hold
# no pricing, so the public catalogue supplies the prices. The usage figures it
# embeds are keyed by permaslug and variant, so they are summed per model to
# report a comparable token volume.
build_most_popular_rows() {
  local popular=$1
  local catalogue=$2

  jq -nr --argjson limit "$limit" \
    --slurpfile popular "$popular" \
    --slurpfile catalogue "$catalogue" '
      def bare_id: sub("-[0-9]{8}$"; "");

      ($catalogue[0].data | map(select(.canonical_slug != null)
          | { key: .canonical_slug, value: . }) | from_entries) as $by_canonical
      | # One model can appear as several dated variants, and some carry a
        # separate :batch variant. Sum them so each model reports one row.
        ($popular[0].data.analytics
          | to_entries
          | map(.value)
          | group_by(.model_permaslug | bare_id)
          | map({
              id: (.[0].model_permaslug | bare_id),
              tokens: (map(.total_prompt_tokens // 0) | add)
            })
          | map({ key: .id, value: .tokens })
          | from_entries) as $tokens

      | $popular[0].data.models[0:$limit]
      | .[]
      | . as $ranked
      | (($by_canonical[$ranked.permaslug] // null) as $entry
          | ($entry.id // ($ranked.slug // "")) as $id
          | [
              $id,
              (($entry.context_length // $ranked.context_length // 0) | tostring),
              (($entry.pricing.prompt // null) | tostring),
              (($entry.pricing.completion // null) | tostring),
              (($tokens[($ranked.permaslug | bare_id)] // 0) | tostring)
            ]
          | @tsv)
    '
}

# OpenCode's leaderboard. Rank and token volume come from its index; the cost,
# the context window and the canonical id are only in the per-model document,
# so each row costs one more request. That document is optional: a model whose
# document is missing keeps its rank and shows the name the leaderboard used,
# with the fields it cannot supply reported as n/a, so the leaderboard stays
# faithful rather than quietly losing a row.
#
# A reported cost of zero does not mean free. OpenCode only fills the cost in
# for some models, and a priced model can report zero, so the cost is shown as
# reported and nothing is inferred from it.
build_opencode_rows() {
  local index=$1
  local detail=$2
  local rank model lab tokens cost context model_id values

  jq -nr --argjson limit "$limit" --arg window "$opencode_window" --slurpfile index "$index" '
    $index[0].leaderboard[$window][0:$limit]
    | .[]
    | [ (.rank | tostring), .model, (.lab // "unknown"), (.tokens | tostring) ]
    | @tsv
  ' | while IFS=$'\t' read -r rank model lab tokens; do
    [ -n "$model" ] || continue

    cost=n/a
    context=null
    model_id=$model

    if fetch_opencode_model "$lab" "$model" >"$detail" 2>/dev/null; then
      # A document that is not the JSON we expect leaves nothing to read, and
      # the defaults above then stand rather than being blanked out. Its parse
      # error is left on stderr, because an undocumented source changing shape
      # is worth noticing.
      values=$(jq -r --argjson days "$opencode_days" --arg fallback "$model" '
        [ ((.usage.daily[-$days:] | map(.costUsd // 0) | add) // 0),
          (.model.contextTokens // "null"),
          (.model.id // $fallback) ]
        | @tsv
      ' "$detail") || values=''

      if [ -n "$values" ]; then
        IFS=$'\t' read -r cost context model_id <<<"$values"
      fi
    fi

    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$rank" \
      "$model_id" \
      "$(format_tokens_compact "$tokens")" \
      "$(format_cost "$cost")" \
      "$(format_context "$context")"
  done
}

# Prices are quoted per token, which is awkward to read. Convert to US dollars
# per million tokens, keeping enough decimals that a tenth-of-a-cent rate does
# not round down to a misleading zero.
format_price() {
  local value=$1

  case "$value" in
    ''|null)
      printf 'n/a'
      return
      ;;
  esac

  # OpenRouter reports a negative price for its own routing models, whose cost
  # depends on the provider chosen at request time. That is not a price.
  if [ "$(printf '%s' "$value" | awk '{print ($1 < 0)}')" = 1 ]; then
    printf 'varies'
    return
  fi

  if [ "$(printf '%s' "$value" | awk '{print ($1 == 0)}')" = 1 ]; then
    printf 'free'
    return
  fi

  jq -nr --arg value "$value" '
    ($value | tonumber) * 1000000 as $per_million
    | if $per_million >= 1
      then ($per_million * 100 | round / 100)
      else ($per_million * 10000 | round / 10000)
      end
    | tostring
    | if . == "0" then "<0.0001" else . end
  '
}

# Context windows are reported in thousands of tokens. Three decimals is exact:
# an integer token count divided by 1000 always lands on a thousandth, so
# 1048576 shows as 1048.576 and multiplying by 1000 recovers it.
format_context() {
  local value=$1

  case "$value" in
    ''|null|0)
      printf 'n/a'
      return
      ;;
  esac

  jq -nr --argjson value "$value" '
    ($value / 1000 * 1000 | round / 1000) | tostring
  '
}

# Compact token counts, e.g. 1234567 -> 1.23M.
format_tokens() {
  local value=$1

  case "$value" in
    ''|null|0)
      printf 'n/a'
      return
      ;;
  esac

  jq -nr --argjson value "$value" '
    if   $value >= 1000000000 then ($value / 1000000000 * 100 | round / 100 | tostring)
    elif $value >= 1000000    then ($value / 1000000    * 100 | round / 100 | tostring)
    elif $value >= 1000       then ($value / 1000       * 100 | round / 100 | tostring)
    else $value | tostring
    end
  '
}

# OpenCode token volumes run from billions to tens of trillions, so unlike the
# OpenRouter tables they carry their unit rather than assuming one.
format_tokens_compact() {
  local value=$1

  case "$value" in
    ''|null|0)
      printf 'n/a'
      return
      ;;
  esac

  jq -nr --argjson value "$value" '
    if   $value >= 1000000000000 then ((($value / 1000000000000) * 100 | round / 100) | tostring) + "T"
    elif $value >= 1000000000    then ((($value / 1000000000)    * 100 | round / 100) | tostring) + "B"
    elif $value >= 1000000       then ((($value / 1000000)       * 100 | round / 100) | tostring) + "M"
    elif $value >= 1000          then ((($value / 1000)          * 100 | round / 100) | tostring) + "K"
    else $value | tostring
    end
  '
}

# Dollars, grouped so a six-figure sum stays legible.
format_cost() {
  local value=$1

  case "$value" in
    ''|null|n/a)
      printf 'n/a'
      return
      ;;
  esac

  printf "%'.2f" "$value"
}

# The two OpenRouter tables share a column shape, so one formatter serves both.
# The builders emit raw values; this turns them into the strings to display.
format_openrouter_rows() {
  local model_id context prompt completion tokens

  while IFS=$'\t' read -r model_id context prompt completion tokens; do
    [ -n "$model_id" ] || continue
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$model_id" \
      "$(format_price "$prompt")" \
      "$(format_price "$completion")" \
      "$(format_context "$context")" \
      "$(format_tokens "$tokens")"
  done <<<"$1"
}

# Render a TSV table. The first column is left aligned, the rest right aligned,
# and every column is as wide as its widest cell, so one printer serves all
# three tables.
print_table() {
  local title=$1
  local header=$2
  local rows=$3

  echo "========================================"
  echo "$title"
  echo "========================================"

  if [ -z "$rows" ]; then
    echo "no models returned"
    echo
    return
  fi

  printf '%s\n' "$rows" | awk -F'\t' -v header="$header" '
    BEGIN {
      n = split(header, h, "\t")
      for (i = 1; i <= n; i++) w[i] = length(h[i])
    }
    {
      line[NR] = $0
      for (i = 1; i <= n; i++) if (length($i) > w[i]) w[i] = length($i)
    }
    END {
      out = ""
      for (i = 1; i <= n; i++) out = out sprintf(i == 1 ? "%-*s" : "  %*s", w[i], h[i])
      print out

      total = 0
      for (i = 1; i <= n; i++) total += w[i]
      total += 2 * (n - 1)
      rule = ""
      for (i = 0; i < total; i++) rule = rule "-"
      print rule

      for (r = 1; r <= NR; r++) {
        split(line[r], f, "\t")
        out = ""
        for (i = 1; i <= n; i++) out = out sprintf(i == 1 ? "%-*s" : "  %*s", w[i], f[i])
        print out
      }
    }
  '

  echo
}

catalogue=$(mktemp)
ranking=$(mktemp)
popular=$(mktemp)
opencode=$(mktemp)
opencode_detail=$(mktemp)
trap 'rm -f "$catalogue" "$ranking" "$popular" "$opencode" "$opencode_detail"' EXIT

fetch_catalogue >"$catalogue"

fetch_trending >"$ranking"
fetch_most_popular >"$popular"
fetch_opencode_index >"$opencode"

# OpenCode publishes a day and a week window but no month, so a month view falls
# back to its week and says so rather than quietly reporting a different window.
case "$view" in
  day)
    opencode_window=pastDay
    opencode_days=1
    opencode_label=day
    ;;
  week|month)
    opencode_window=pastWeek
    opencode_days=7
    opencode_label=week
    ;;
esac

openrouter_header=$(printf 'MODEL ID\tIN ($/M)\tOUT ($/M)\tCTX (k)\tTOKENS (B)')

print_table "Most Popular" \
  "$openrouter_header" \
  "$(format_openrouter_rows "$(build_most_popular_rows "$popular" "$catalogue")")"

print_table "Trending by tokens ($view)" \
  "$openrouter_header" \
  "$(format_openrouter_rows "$(build_trending_rows "$ranking" "$catalogue" "$popular")")"

print_table "OpenCode by tokens ($opencode_label)" \
  "$(printf 'RANK\tMODEL ID\tTOKENS\tCOST ($)\tCTX (k)')" \
  "$(build_opencode_rows "$opencode" "$opencode_detail")"

if [ "$view" != "$opencode_label" ]; then
  echo "note: OpenCode publishes no month window, so its week is shown above"
  echo
fi

echo "Sources: https://openrouter.ai/rankings, https://openrouter.ai/models and https://opencode.ai/data/"
