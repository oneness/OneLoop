#!/usr/bin/env bash
set -euo pipefail

ONELOOP_ORIGINAL_DIR="$(pwd)"
export ONELOOP_ORIGINAL_DIR
cd "$(dirname "$(readlink -f "$0")")"

usage() {
  echo "usage: ols [qwen|qwen-coder-7b] [llama-server options...]"
}

default="qwen-coder-7b"
model="${1:-$default}"
if [ $# -gt 0 ]; then
  shift
fi

case "$model" in
  qwen|qwen-coder-7b) ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    echo "unknown model: $model" >&2
    usage >&2
    exit 2
    ;;
esac

port="${ONELOOP_LOCAL_PORT:-8080}"
backend="${ONELOOP_BACKEND:-vulkan}"

# Select the right llama-server package
case "$backend" in
  vulkan)
    llama_server_pkg=".#llama-server-vulkan"
    ;;
  rocm)
    llama_server_pkg=".#llama-server-rocm"
    # ROCm needs these env vars for RDNA 3.5 (gfx1150 / Radeon 890M)
    export HSA_OVERRIDE_GFX_VERSION=11.5.0
    export GPU_MAX_HW_QUEUES=4
    export ROCBLAS_USE_HIPBLASLT=1
    export HSA_ENABLE_SDMA=0
    export HIP_FORCE_DEV_KERNARG=1
    export PYTORCH_ROCM_ARCH=gfx1150  # may help
    ;;
  *)
    echo "unknown backend: $backend (use vulkan or rocm)" >&2
    exit 2
    ;;
esac

if curl -s -m 2 "localhost:$port/health" 2>/dev/null | grep -q ok; then
  echo "a server is already serving on :$port — just use \`ol\`." >&2
  exit 1
fi

run_server() {
  local model_path=$1
  shift
  exec nix shell "$llama_server_pkg" --command llama-server \
    -m "$model_path" \
    -t 12 -c 131072 -n 32768 \
    --load-mode  mmap \
    --jinja --reasoning-preserve --reasoning-budget 600 \
    --host 127.0.0.1 --port "$port" --alias "$model" \
    "$@"
}

case "$model" in
  qwen)
    # Keep existing 35B MoE as "qwen" for backward compat
    model_file="Qwen3.6-35B-A3B-Q4_K_M.gguf"
    default_model="$HOME/models/$model_file"
    model_path="${ONELOOP_LOCAL_MODEL:-$default_model}"

    if [ $# -gt 0 ] && [ "${1##*.}" = "gguf" ]; then
      model_path="$1"
      shift
    fi

    if [ ! -f "$model_path" ]; then
      if [ "$model_path" != "$default_model" ]; then
        echo "no model at $model_path" >&2
        exit 1
      fi
      if [ ! -t 0 ]; then
        echo "no model at $model_path" >&2
        echo "run ./download-qwen to fetch it" >&2
        exit 1
      fi
      echo "No model at $model_path"
      printf 'Download Qwen 35B MoE now? [y/N] '
      read -r reply
      case "$reply" in
        [yY]*) ./download-qwen ;;
        *) echo "aborted" >&2; exit 1 ;;
      esac
      [ -f "$model_path" ] || { echo "download failed" >&2; exit 1; }
    fi
    run_server "$model_path" "$@"
    ;;

  qwen-coder-7b)
    model_file="qwen2.5-coder-7b-instruct-q4_k_m.gguf"
    default_model="$HOME/models/$model_file"
    model_path="${ONELOOP_LOCAL_MODEL:-$default_model}"

    if [ $# -gt 0 ] && [ "${1##*.}" = "gguf" ]; then
      model_path="$1"
      shift
    fi

    if [ ! -f "$model_path" ]; then
      if [ "$model_path" != "$default_model" ]; then
        echo "no model at $model_path" >&2
        exit 1
      fi
      if [ ! -t 0 ]; then
        echo "no model at $model_path" >&2
        echo "run ./download-qwen-coder-7b to fetch it" >&2
        exit 1
      fi
      echo "No model at $model_path"
      printf 'Download Qwen2.5-Coder 7B now? [y/N] '
      read -r reply
      case "$reply" in
        [yY]*) ./download-qwen-coder-7b ;;
        *) echo "aborted" >&2; exit 1 ;;
      esac
      [ -f "$model_path" ] || { echo "download failed" >&2; exit 1; }
    fi
    run_server "$model_path" "$@"
    ;;
esac